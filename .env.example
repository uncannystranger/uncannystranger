VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serverless-only values. Add these in Vercel project settings, never in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_USERNAME=uncannystranger
CRON_SECRET=

# Direct contact delivery. Never use VITE_ prefixes for these server-only settings.
# Enable only after verified DNS, Turnstile, WAF quota and an inbox / Reply-To test.
CONTACT_ENABLED=false
CONTACT_RATE_LIMIT_READY=false
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
CONTACT_FROM=Uncanny Stranger <contact@uncannystranger.com>
# Optional exact HTTPS *.vercel.app review origin (also authorize it in Turnstile).
CONTACT_PREVIEW_ORIGIN=
